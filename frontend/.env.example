# GenLayer network -- selects which genlayer-js/chains export to use
# (localnet | studionet | testnet-asimov | testnet-bradbury). The chain
# object carries its own RPC/explorer URLs; there is no separate URL to set.
NEXT_PUBLIC_GENLAYER_CHAIN=testnet-bradbury

# Deployed contract address (set after running deploy/deploy.mjs)
NEXT_PUBLIC_CLAIM_FACTORY_ADDRESS=

# WalletConnect Cloud project id (create one at https://cloud.walletconnect.com).
# Injected wallets (MetaMask, etc.) work fine without this; only the
# WalletConnect QR/remote-config path degrades to a placeholder fallback
# if left unset. See rainbowkit-wagmi-nextjs-gotchas.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
